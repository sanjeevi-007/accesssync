# ACCESS-EASE Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Database
DATABASE_URL=sqlite:///./database/accesssync.db

# Security
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Default Admin (changed on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# Device
DEVICE_TOKEN_HASH=CHANGE_ME_TO_HASHED_TOKEN

# Server
HOST=0.0.0.0
PORT=8000

# WebSocket
WS_HEARTBEAT_TIMEOUT_SECONDS=45

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
